  <diagram id="fig6_7" name="图6-7 RBAC四步权限校验算法">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="API请求到达" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="input" value="输入: request, permission_code" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="步骤1: 提取令牌
token = extract_bearer_token(...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="token 存在 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e401a" value="返回 401 缺少认证令牌" style="shape=process;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="720" y="370" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="decode" value="payload = jwt.decode(token, SECRET, HS256)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="payload 有效 且
payload.type == 'access' ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e401b" value="返回 401 令牌无效" style="shape=process;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="720" y="590" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="步骤2: 身份查询
