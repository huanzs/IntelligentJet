<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Qoder" version="24.0.0">
  <diagram id="fig6_4" name="图6-4 消防炮与云台角度同步映射算法">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始 / PTZ追踪到达目标角度" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="input" value="输入: ptz_h, ptz_v
参数: H_OFFSET, V_FIXED, V_MODE" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hcalc" value="slm_h = ptz_h + H_OFFSET" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vmode" value="V_MODE == 'sync' ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vsync" value="slm_v = ptz_v
俯仰跟随PTZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="140" y="480" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vfixed" value="slm_v = V_FIXED
固定仰角(默认20°)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="500" y="480" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="norm" value="slm_h = normalize_angle(slm_h, 0, 360)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="clamp" value="slm_v = clamp(slm_v, 0, 90)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="700" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="send" value="send_slm_position_command(slm_h, slm_v)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="810" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="输出: 消防炮到达(slm_h, slm_v)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="920" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="1030" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="start" target="input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="input" target="hcalc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="hcalc" target="vmode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="是" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="vmode" target="vsync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="否" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="vmode" target="vfixed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="vsync" target="norm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="vfixed" target="norm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="norm" target="clamp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="clamp" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="send" target="out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="out" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>