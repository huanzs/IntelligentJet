<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Qoder" version="24.0.0">
  <diagram id="fig6_2" name="图6-2 画面坐标到云台旋转增量算法">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始 / 火焰确认触发" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="input" value="输入: cx, cy, frame_w, frame_h
hfov, vfov, current_h, current_v" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="offx" value="offset_x = (cx - frame_w/2) / frame_w" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="offy" value="offset_y = (cy - frame_h/2) / frame_h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dh" value="delta_h = offset_x × hfov" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dv" value="delta_v = offset_y × vfov" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="newh" value="new_h = current_h + delta_h
new_v = current_v + delta_v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="700" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="clamp" value="new_h = clamp(new_h, h_min, h_max)
new_v = clamp(new_v, v_min, v_max)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="810" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="send" value="send_ptz_absolute_angle(new_h, new_v)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="920" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="输出: (new_h, new_v)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="1030" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="结束 / 进入闭环下一帧" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="1140" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="start" target="input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="input" target="offx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="offx" target="offy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="offy" target="dh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="dh" target="dv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="dv" target="newh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="newh" target="clamp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="clamp" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="send" target="out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="out" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>